{
	"schemaVersion": 1,
	"id": "rustium",
	"version": "${version}",
	"name": "Rustium",
	"description": "Extreme optimization mod using Rust offloading and approximate algorithms.",
	"authors": [
		"fukayatti0"
	],
	"contact": {
		"homepage": "https://github.com/nitic-pro/rustium",
		"sources": "https://github.com/nitic-pro/rustium"
	},
	"license": "CC0-1.0",
	"icon": "assets/rustium/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"pro.nitic.rustium.RustiumMod"
		],
		"client": [
			"pro.nitic.rustium.client.RustiumClient"
		]
	},
	"mixins": [
		"rustium.mixins.json",
		{
			"config": "rustium.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.6",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}